{
  "name": "live-agentic-html-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Comment on and edit a live HTML page in the browser; hand every change back to your coding agent.",
  "bin": {
    "lahe": "bin/lahe.js"
  },
  "license": "MIT",
  "keywords": [
    "live review",
    "coding agents",
    "claude code",
    "codex",
    "antigravity",
    "html",
    "markdown",
    "review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenxle/live-agentic-html-editor.git"
  },
  "homepage": "https://github.com/kenxle/live-agentic-html-editor#readme",
  "bugs": {
    "url": "https://github.com/kenxle/live-agentic-html-editor/issues"
  },
  "engines": {
    "node": ">=18.2.0"
  },
  "scripts": {
    "lint": "node scripts/lint.js",
    "install-cli": "node scripts/install-cli.js",
    "install-skills": "node scripts/install-skills.js",
    "build:layer": "node scripts/build-layer.js",
    "check:layer": "node scripts/build-layer.js --check",
    "test:unit": "node --test test/unit/",
    "test:browser": "playwright test",
    "test:browser:all": "LAHE_ALL_BROWSERS=1 playwright test",
    "gate": "npm run lint && npm run check:layer && npm run test:unit && npm run test:browser",
    "gate:builder": "npm run lint && npm run test:unit && npm run test:browser",
    "gate:all": "npm run lint && npm run check:layer && npm run test:unit && npm run test:browser:all"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
